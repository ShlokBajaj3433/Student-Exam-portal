# ── Docker Compose Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values before running docker-compose.
#
#   cp .env.example .env
#
# .env is gitignored — never commit it with real credentials.

# PostgreSQL password used by both the db service (POSTGRES_PASSWORD)
# and the app service (SUPABASE_DB_PASSWORD).
DB_PASSWORD=<your-database-password>

# PostgreSQL username (POSTGRES_USER / SUPABASE_DB_USER).
# Default value used by PostgreSQL images is "postgres".
SUPABASE_DB_USER=postgres

# Base64-encoded HS256 JWT secret key (minimum 256-bit / 32 bytes).
# Generate a secure random value with:
#   openssl rand -base64 32
APP_JWT_SECRET=<base64-encoded-256-bit-secret>
